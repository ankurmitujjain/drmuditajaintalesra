---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';
import CallCTA from '@/components/CallCTA.astro';
import { site } from '@/data/site';

const title = "Clinic & Treatments in Bhopal | Dr. Mudita Jain Talesra";
const metaDescription = "Visit Dr. Mudita Jain Talesra’s clinic in Gulmohar Colony, Bhopal. State-of-the-art diagnostic facilities and personalized gynecologic care.";
---

<Base title={title} metaDescription={metaDescription}>
  <div class="page-container container">
    <Breadcrumbs crumbs={[{ name: "Clinic & Treatments", url: "/clinic-and-treatments/" }]} />

    <header class="page-header">
      <span class="badge">Modern Outpatient Facility</span>
      <h1>Clinic & Diagnostic Treatments</h1>
      <p class="lead">
        <strong>Mudita Women Health Care Center</strong>, E-8, Plot G-1/24-25, Gulmohar Colony, Bhopal.
      </p>
    </header>

    <div class="clinic-grid">
      <div class="clinic-main">
        <section class="clinic-section">
          <h2>About Mudita Women Health Care Center</h2>
          <p>
            Established by <strong>{site.doctor.name} ({site.doctor.qualifications})</strong>, our clinical facility in Gulmohar Colony, Bhopal is dedicated to providing confidential, compassionate, and evidence-based outpatient consultations.
          </p>
          <p>
            Designed specifically to offer comfort and privacy, the clinic offers dedicated consultation rooms, sterile procedural zones, and advanced diagnostic evaluation equipment for women across all age groups.
          </p>
        </section>

        <section class="facilities-section">
          <h2>Key Diagnostic & Outpatient Services</h2>
          <ul class="facilities-list">
            <li>
              <strong>Comprehensive Gynecological Consultations:</strong> Expert diagnosis of menstrual irregularities, pelvic pain, ovarian cysts, uterine fibroids, and vaginal infections.
            </li>
            <li>
              <strong>Antenatal & Fetal Wellness Checks:</strong> Routine maternal health monitoring, blood pressure screening, gestational diabetes management, and fetal heart auscultation.
            </li>
            <li>
              <strong>Cervical Cancer Screening:</strong> Liquid-based cytology (LBC) Pap smears, high-risk HPV DNA testing, and colposcopy referrals.
            </li>
            <li>
              <strong>Infertility Workups:</strong> Follicular tracking, hormonal assessment (AMH, thyroid, prolactin), and preconceptional counseling.
            </li>
            <li>
              <strong>Adolescent & Menopause Clinics:</strong> Specialized guidance for teenagers dealing with painful periods or PCOS, and women navigating perimenopause and menopause.
            </li>
            <li>
              <strong>Confidential Reproductive Consultations:</strong> Respectful, private family planning, contraception counseling, and legal CAC/MTP services.
            </li>
          </ul>
        </section>

        <div class="cta-banner">
          <h3>Schedule Your Consultation at Gulmohar Colony</h3>
          <p>Consultation Hours: Monday to Friday, 5:00 PM – 8:00 PM</p>
          <div class="cta-banner-buttons">
            <WhatsAppCTA title="Clinic Consultation" question="Hello Dr. Mudita, I would like to book an appointment at your Gulmohar clinic." slug="clinic-page" />
            <CallCTA />
          </div>
        </div>
      </div>

      <aside class="clinic-sidebar">
        <div class="sidebar-card">
          <img src="/images/clinic-entrance.webp" alt="Clinic Entrance Bhopal" width="350" height="220" class="sidebar-photo" />
          <h3>Practice Highlights</h3>
          <ul class="highlights-list">
            <li>✅ 17+ Years Clinical Experience</li>
            <li>✅ MPMC Registered Specialist</li>
            <li>✅ Strict Patient Confidentiality</li>
            <li>✅ High-Definition Laparoscopic Surgery</li>
            <li>✅ Centrally Located in Gulmohar Colony</li>
          </ul>
          <a href={site.nap.mapsCidUrl} target="_blank" rel="noopener" class="btn-directions">Get Driving Directions 📍</a>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .page-container {
    padding: 30px 20px 60px 20px;
  }
  .page-header {
    margin-bottom: 35px;
  }
  .badge {
    background: #e0f2fe;
    color: #0369a1;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: inline-block;
    margin-bottom: 10px;
  }
  .page-header h1 {
    font-size: 34px;
    color: #172b54;
    margin-bottom: 10px;
  }
  .lead {
    font-size: 16px;
    color: #475569;
  }

  .clinic-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .clinic-main section {
    margin-bottom: 35px;
  }
  .clinic-main h2 {
    font-size: 22px;
    color: #172b54;
    margin-bottom: 12px;
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 6px;
  }
  .clinic-main p {
    font-size: 15px;
    line-height: 1.7;
    color: #334155;
    margin-bottom: 12px;
  }
  .facilities-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .facilities-list li {
    font-size: 14px;
    line-height: 1.6;
    color: #475569;
    background: #f8fafc;
    border-left: 3px solid #172b54;
    padding: 12px 16px;
    border-radius: 0 6px 6px 0;
  }
  .facilities-list strong {
    color: #172b54;
  }

  .cta-banner {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 10px;
    padding: 24px;
    text-align: center;
    margin-top: 30px;
  }
  .cta-banner h3 {
    font-size: 19px;
    color: #172b54;
    margin-bottom: 6px;
  }
  .cta-banner p {
    font-size: 14px;
    color: #475569;
    margin-bottom: 16px;
  }
  .cta-banner-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .sidebar-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px;
    position: sticky;
    top: 80px;
  }
  .sidebar-photo {
    width: 100%;
    height: auto;
    border-radius: 6px;
    margin-bottom: 16px;
  }
  .sidebar-card h3 {
    font-size: 17px;
    color: #172b54;
    margin-bottom: 12px;
  }
  .highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    color: #334155;
    margin-bottom: 20px;
  }
  .btn-directions {
    display: block;
    background: #172b54;
    color: #ffffff !important;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    padding: 10px;
    border-radius: 6px;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .clinic-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
