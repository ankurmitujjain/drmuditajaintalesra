---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';
import CallCTA from '@/components/CallCTA.astro';
import FAQ from '@/components/FAQ.astro';
import { site } from '@/data/site';

const title = "Gynecological Surgical Second Opinion | Dr. Mudita Jain Talesra";
const metaDescription = "Thorough, unbiased second opinion on hysterectomy, uterine fibroids, ovarian cysts, and surgery by Dr. Mudita Jain Talesra (MS, FMAS, FICOG).";

const faqs = [
  {
    question: "When should I seek a second opinion for gynecological surgery?",
    answer: "A second opinion is recommended if you have been advised to have a hysterectomy (बच्चेदानी निकालना), if you are young and wish to preserve your uterus or ovaries for future pregnancy, if previous treatments for fibroids or endometriosis have not brought relief, or if your diagnosis remains unclear.",
  },
  {
    question: "How do I share my scans and diagnostic reports?",
    answer: "Once you connect with our clinic on WhatsApp and confirm your appointment, you can share clear photos or PDF documents of your pelvic ultrasound scans, MRI reports, blood work, and operative notes directly in the secure chat.",
  },
  {
    question: "What is included in the surgical second opinion service?",
    answer: "The service includes an in-depth clinical analysis of your imaging and medical history, an objective evaluation of whether non-surgical or minimally invasive keyhole alternatives are viable, and a structured written clinical opinion delivered within 48 hours, followed by an optional video discussion.",
  },
];
---

<Base title={title} metaDescription={metaDescription}>
  <div class="page-container container">
    <Breadcrumbs
      crumbs={[
        { name: "Online Care", url: "/online-care/" },
        { name: "Second Opinion", url: "/second-opinion/" },
      ]}
    />

    <header class="page-header">
      <span class="badge">Clinical & Surgical Review</span>
      <h1>Objective Gynecological Second Opinion</h1>
      <p class="lead">
        Experienced, unbiased review of your surgical recommendations and imaging scans. Explore minimally invasive alternatives before making a major decision.
      </p>
    </header>

    <div class="opinion-grid">
      <div class="main-body">
        <section class="card">
          <h2>Clear Answers Before Surgery</h2>
          <p>
            Being told you need surgery—such as a hysterectomy or major abdominal operation—can feel overwhelming. Many women across India are advised surgical intervention without having fully explored modern minimally invasive laparoscopic procedures or uterine-sparing medical therapies.
          </p>
          <p>
            With over 17 years of surgical and clinical expertise, <strong>Dr. Mudita Jain Talesra</strong> (MS OBG, FMAS, FICOG) provides clear, objective, and evidence-based second opinions. Our priority is your long-term health, anatomical preservation, and peace of mind.
          </p>
        </section>

        <section class="card">
          <h2>Conditions Commonly Evaluated for Second Opinions</h2>
          <div class="conditions-grid">
            <div class="condition-item">
              <h3>Uterine Fibroids (रसोली)</h3>
              <p>Evaluating whether laparoscopic myomectomy (fibroid enucleation preserving the uterus) or medical therapy is appropriate instead of a total hysterectomy.</p>
            </div>
            <div class="condition-item">
              <h3>Ovarian Cysts & Endometriomas</h3>
              <p>Assessing benign vs. complex cysts and exploring ovarian-sparing laparoscopic cystectomy to protect future fertility and hormonal reserve.</p>
            </div>
            <div class="condition-item">
              <h3>Adenomyosis & Heavy Bleeding (AUB)</h3>
              <p>Reviewing conservative alternatives including hormonal intrauterine devices (LNG-IUS) and medical protocols before irreversible surgical removal.</p>
            </div>
            <div class="condition-item">
              <h3>High-Risk Pregnancy Scans</h3>
              <p>Interpretation of anomaly scans, fetal growth variations, and delivery planning for expectant mothers requiring specialized maternal-fetal perspectives.</p>
            </div>
          </div>
        </section>

        <section class="card">
          <h2>How the Second Opinion Flow Works</h2>
          <div class="steps-flow">
            <div class="flow-step">
              <span class="badge-step">Step 1</span>
              <h4>Request on WhatsApp</h4>
              <p>Send your second opinion inquiry naming your primary diagnosis (e.g. <code>[web-second-opinion]</code>).</p>
            </div>
            <div class="flow-step">
              <span class="badge-step">Step 2</span>
              <h4>Upload Medical Records</h4>
              <p>Share photos/PDFs of your recent ultrasound images, MRI, endometrial biopsy, and blood reports.</p>
            </div>
            <div class="flow-step">
              <span class="badge-step">Step 3</span>
              <h4>UPI Payment & Review</h4>
              <p>Confirm the consultation fee and transfer via UPI to <strong>+91 99938 95629</strong>. Dr. Mudita conducts an in-depth clinical analysis.</p>
            </div>
            <div class="flow-step">
              <span class="badge-step">Step 4</span>
              <h4>Written Opinion & Video Discussion</h4>
              <p>Receive your written clinical summary within 48 hours, followed by an optional scheduled video consultation.</p>
            </div>
          </div>
        </section>

        <section class="card">
          <h2>Frequently Asked Questions</h2>
          <FAQ faqs={faqs} />
        </section>
      </div>

      <aside class="sidebar">
        <div class="sidebar-box">
          <h3>Request Second Opinion</h3>
          <p>Connect with Dr. Mudita's clinic desk to share your case details.</p>
          <div class="sidebar-ctas">
            <WhatsAppCTA title="Request Second Opinion" question="Hello Dr. Mudita, I would like a second opinion on my surgical reports. [web-second-opinion]" slug="second-opinion-cta" />
            <CallCTA />
          </div>
        </div>

        <div class="sidebar-box note-box">
          <h4>Policy & Anti-Fraud</h4>
          <p><small>We confirm availability before accepting any fee. Official UPI: <strong>+91 99938 95629</strong>. <a href="/how-to-book/">How to book →</a></small></p>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .page-container {
    padding: 30px 20px 60px 20px;
  }
  .page-header {
    margin-bottom: 35px;
  }
  .badge {
    background: #e0f2fe;
    color: #0369a1;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 4px;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 10px;
  }
  .page-header h1 {
    font-size: 32px;
    color: #172b54;
    margin-bottom: 10px;
  }
  .lead {
    font-size: 16px;
    color: #475569;
    max-width: 800px;
  }
  .opinion-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 40px;
  }
  .card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 30px;
    margin-bottom: 30px;
  }
  .card h2 {
    color: #172b54;
    font-size: 22px;
    margin-bottom: 16px;
  }
  .card p {
    font-size: 15px;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 14px;
  }
  .conditions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 20px;
  }
  .condition-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 18px;
  }
  .condition-item h3 {
    font-size: 16px;
    color: #172b54;
    margin-bottom: 8px;
  }
  .condition-item p {
    font-size: 13px;
    color: #64748b;
    margin: 0;
    line-height: 1.6;
  }
  .steps-flow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 20px;
  }
  .flow-step {
    border-left: 3px solid #0284c7;
    padding-left: 15px;
  }
  .badge-step {
    font-size: 11px;
    background: #e0f2fe;
    color: #0369a1;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 700;
    display: inline-block;
    margin-bottom: 6px;
  }
  .flow-step h4 {
    font-size: 15px;
    color: #1e293b;
    margin-bottom: 6px;
  }
  .flow-step p {
    font-size: 13px;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }
  .sidebar-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 25px;
  }
  .sidebar-box h3, .sidebar-box h4 {
    color: #172b54;
    margin-bottom: 12px;
  }
  .sidebar-box p {
    font-size: 14px;
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .note-box {
    background: #f8fafc;
  }
  .note-box a {
    color: #0284c7;
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .opinion-grid {
      grid-template-columns: 1fr;
    }
    .conditions-grid, .steps-flow {
      grid-template-columns: 1fr;
    }
  }
</style>

