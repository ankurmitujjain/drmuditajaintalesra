---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';
import CallCTA from '@/components/CallCTA.astro';
import { site } from '@/data/site';

const title = "Terms of Service & Telemedicine Policy | Dr. Mudita Jain Talesra";
const metaDescription = "Terms and conditions governing clinical teleconsultations, digital education programs, and website use with Dr. Mudita Jain Talesra.";
---

<Base title={title} metaDescription={metaDescription}>
  <div class="page-container container">
    <Breadcrumbs crumbs={[{ name: "Terms of Service", url: "/terms/" }]} />

    <header class="page-header">
      <span class="badge">Legal Terms & Telemedicine Consent</span>
      <h1>Terms of Service</h1>
      <p class="lead">Last updated: November 8, 2026</p>
    </header>

    <div class="terms-content">
      <section>
        <h2>1. Compliance with Telemedicine Practice Guidelines (India 2020)</h2>
        <p>
          All online teleconsultations provided by <strong>Dr. Mudita Jain Talesra</strong> (Registered Medical Practitioner, Madhya Pradesh Medical Council Reg. No. MP-8475) strictly adhere to the <em>Telemedicine Practice Guidelines</em> issued jointly by the Board of Governors in supersession of the Medical Council of India (MCI) / National Medical Commission (NMC).
        </p>
        <p>
          By booking and attending a teleconsultation, the patient explicitly consents to receiving clinical advice via audio-video or text medium. The patient acknowledges that an online consultation has intrinsic clinical limitations and does not fully replicate a physical in-person clinical examination.
        </p>
      </section>

      <section>
        <h2>2. Medical Emergency Disclaimer</h2>
        <div class="emergency-box">
          <p>
            <strong>EMERGENCY WARNING:</strong> Telemedicine consultations are strictly unsuitable for acute medical emergencies. If you are experiencing sudden severe lower abdominal or pelvic pain, uncontrollable vaginal bleeding, sudden fainting, high fever, or acute pregnancy complications, do NOT wait for an online reply. Proceed immediately to the nearest hospital emergency room.
          </p>
        </div>
      </section>

      <section>
        <h2>3. Prescriptions & Medication Limitations</h2>
        <p>
          Prescriptions generated during telemedicine consultations strictly follow regulatory Schedule constraints. Controlled substances, habit-forming psychiatric medications, and restricted drugs (Schedule X) will never be prescribed online. All medical prescriptions are delivered in digital format with the doctor’s registration number (MPMC MP-8475).
        </p>
      </section>

      <section>
        <h2>4. Educational & Academic Services</h2>
        <p>
          Educational courses, recorded surgical technique lectures, and resident mentorship webinars provided under "The GynaeSurgeon Vault" / Dr. Mudita Jain Academy are for academic enrichment and training purposes only. They do not confer medical licenses or hospital surgical privileges.
        </p>
      </section>

      <section>
        <h2>5. Jurisdiction</h2>
        <p>
          These terms and all medical consultations provided are governed by the laws of India and are subject to the exclusive jurisdiction of the competent courts in Bhopal, Madhya Pradesh.
        </p>
      </section>
    </div>
  </div>
</Base>

<style>
  .page-container {
    padding: 30px 20px 60px 20px;
  }
  .page-header {
    margin-bottom: 35px;
  }
  .badge {
    background: #e0f2fe;
    color: #0369a1;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 4px;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 10px;
  }
  .terms-content {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 35px;
    max-width: 900px;
  }
  .terms-content section {
    margin-bottom: 30px;
  }
  .terms-content h2 {
    color: #172b54;
    font-size: 20px;
    margin-bottom: 12px;
  }
  .terms-content p {
    color: #475569;
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 10px;
  }
  .emergency-box {
    background: #fef2f2;
    border-left: 4px solid #ef4444;
    padding: 16px 20px;
    border-radius: 6px;
    color: #991b1b;
  }
  .emergency-box strong {
    color: #b91c1c;
  }
</style>

