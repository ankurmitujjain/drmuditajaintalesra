---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';
import CallCTA from '@/components/CallCTA.astro';
import FAQ from '@/components/FAQ.astro';
import { site } from '@/data/site';

const title = "Online Gynecologist Video Consultation | Dr. Mudita Jain Talesra";
const metaDescription = "Book a confidential online video consultation with senior gynecologist Dr. Mudita Jain Talesra (MS OBG, FICOG). Follow-ups, reports review, digital prescription.";

const faqs = [
  {
    question: "Who is an online video consultation suitable for?",
    answer: "Online teleconsultation is ideal for patients residing outside Bhopal, routine follow-up reviews, second opinions on ultrasound/MRI scans, menstrual irregularity discussions, preconception planning, and lifestyle management of PCOS.",
  },
  {
    question: "How does the booking and payment process work?",
    answer: "Tap 'Book Online Consult' to open WhatsApp with a prefilled request. Our clinic desk confirms doctor availability and slot. Once you confirm, transfer the consultation fee via UPI to +91 99938 95629 and share the screenshot. Your Google Meet or WhatsApp video call link is delivered in the chat.",
  },
  {
    question: "Will I receive a valid medical prescription?",
    answer: "Yes. Following your video consultation, a digitally signed prescription with Dr. Mudita's registration number (MPMC Reg. MP-8475) is provided via WhatsApp and email, compliant with Indian Telemedicine Practice Guidelines.",
  },
  {
    question: "What should I do if my symptoms are severe or sudden?",
    answer: "Telemedicine is strictly for non-emergency medical advice. For severe acute pain, heavy uncontrollable bleeding, or acute pregnancy emergencies, proceed immediately to the nearest hospital emergency department.",
  },
];
---

<Base title={title} metaDescription={metaDescription}>
  <div class="page-container container">
    <Breadcrumbs
      crumbs={[
        { name: "Online Care", url: "/online-care/" },
        { name: "Online Consultation", url: "/consult-online/" },
      ]}
    />

    <header class="page-header">
      <span class="badge">Telemedicine Service</span>
      <h1>Online Video Consultation with Dr. Mudita Jain Talesra</h1>
      <p class="lead">
        Private, compassionate gynecological care and report review from anywhere. Compliant with Indian Telemedicine Practice Guidelines 2020.
      </p>
    </header>

    <div class="consult-grid">
      <div class="main-body">
        <section class="card">
          <h2>Direct Care Tailored to Your Schedule</h2>
          <p>
            Whether you reside outside Bhopal, are balancing a demanding professional schedule, or seek an experienced gynecologist's opinion on your ultrasound reports, an online consultation bridges the geographical gap.
          </p>
          <p>
            During your 20 to 30 minute private video appointment, <strong>Dr. Mudita Jain Talesra</strong> (MS OBG, FMAS, FICOG) reviews your symptoms, analyzes your previous medical history and diagnostic reports, and outlines an evidence-based care plan.
          </p>
        </section>

        <section class="card">
          <h2>How It Works in 4 Simple Steps</h2>
          <div class="steps-list">
            <div class="step">
              <span class="step-num">1</span>
              <div>
                <strong>Connect on WhatsApp:</strong> Tap the consultation button below to send your prefilled appointment request.
              </div>
            </div>
            <div class="step">
              <span class="step-num">2</span>
              <div>
                <strong>Confirm Slot & Fee:</strong> Our clinic coordinator confirms doctor availability, offers convenient time slots, and shares the consultation fee.
              </div>
            </div>
            <div class="step">
              <span class="step-num">3</span>
              <div>
                <strong>Pay via UPI:</strong> Complete your payment to our official clinic UPI number: <strong>+91 99938 95629</strong> and share the screenshot in the chat.
              </div>
            </div>
            <div class="step">
              <span class="step-num">4</span>
              <div>
                <strong>Join Video Consultation:</strong> Receive your secure video call link (Google Meet / WhatsApp Video) and intake instructions.
              </div>
            </div>
          </div>
          <p class="note-box">
            <strong>Anti-Fraud Guarantee:</strong> We confirm availability before accepting any fee. We only accept payments to <strong>+91 99938 95629</strong>. <a href="/how-to-book/">Read full policy →</a>
          </p>
        </section>

        <section class="card">
          <h2>What You Need for the Consultation</h2>
          <ul class="check-list">
            <li>A stable internet connection on a smartphone, tablet, or laptop.</li>
            <li>Photos or PDF copies of your recent ultrasound scans, blood tests, and prior prescriptions.</li>
            <li>A quiet, well-lit private space where you can speak comfortably.</li>
            <li>A list of current medications and your last menstrual period (LMP) date.</li>
          </ul>
        </section>

        <section class="card">
          <h2>Frequently Asked Questions</h2>
          <FAQ faqs={faqs} />
        </section>
      </div>

      <aside class="sidebar">
        <div class="sidebar-box booking-box">
          <h3>Book Online Consultation</h3>
          <p>Tap below to start your request on WhatsApp. Availability and fee are confirmed in chat.</p>
          <div class="sidebar-ctas">
            <WhatsAppCTA title="Book Online Consult" question="Hello Dr. Mudita, I would like an online consultation. Please share available slots. [web-consult]" slug="consult-online-cta" />
            <CallCTA />
          </div>
          <div class="secure-badge">
            🔒 Telemedicine Practice Guidelines (India 2020) Compliant
          </div>
        </div>

        <div class="sidebar-box">
          <h4>Clinical Guidelines Notice</h4>
          <p><small>Telemedicine consultations cannot replace emergency medical evaluations. In acute emergencies, visit your nearest hospital emergency room.</small></p>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .page-container {
    padding: 30px 20px 60px 20px;
  }
  .page-header {
    margin-bottom: 35px;
  }
  .badge {
    background: #e0f2fe;
    color: #0369a1;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 4px;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 10px;
  }
  .page-header h1 {
    font-size: 32px;
    color: #172b54;
    margin-bottom: 10px;
  }
  .lead {
    font-size: 16px;
    color: #475569;
    max-width: 800px;
  }
  .consult-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 40px;
  }
  .card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 30px;
    margin-bottom: 30px;
  }
  .card h2 {
    color: #172b54;
    font-size: 22px;
    margin-bottom: 16px;
  }
  .card p {
    font-size: 15px;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 14px;
  }
  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 20px 0;
  }
  .step {
    display: flex;
    gap: 15px;
    align-items: flex-start;
    font-size: 15px;
    color: #334155;
  }
  .step-num {
    width: 28px;
    height: 28px;
    background: #172b54;
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .note-box {
    background: #f8fafc;
    border-left: 4px solid #0284c7;
    padding: 12px 16px;
    font-size: 14px;
    color: #334155;
    border-radius: 4px;
  }
  .note-box a {
    color: #0284c7;
    font-weight: 600;
  }
  .check-list {
    padding-left: 20px;
    color: #475569;
    font-size: 15px;
    line-height: 1.8;
  }
  .sidebar-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 25px;
  }
  .booking-box {
    border-top: 4px solid #25d366;
  }
  .sidebar-box h3, .sidebar-box h4 {
    color: #172b54;
    margin-bottom: 12px;
  }
  .sidebar-box p {
    font-size: 14px;
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .secure-badge {
    margin-top: 15px;
    font-size: 12px;
    color: #0f766e;
    background: #f0fdfa;
    padding: 8px 12px;
    border-radius: 6px;
    text-align: center;
  }
  @media (max-width: 900px) {
    .consult-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

