---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';
import CallCTA from '@/components/CallCTA.astro';
import { site } from '@/data/site';

const title = "How to Book Consultations & Digital Services | Dr. Mudita Jain Talesra";
const metaDescription = "Transparent WhatsApp-first booking flow and UPI payment policy for online consultations, second opinions, and programs with Dr. Mudita Jain Talesra.";

const schema = {
  '@type': 'HowTo',
  '@id': `${site.domain}/how-to-book/#howto`,
  name: 'How to Book an Online Consultation or Program',
  description: 'Step-by-step guidance on booking teleconsultations and digital health services with Dr. Mudita Jain Talesra.',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Connect on WhatsApp',
      text: 'Click any consultation or program button to open WhatsApp with a prefilled request.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Confirm Slot & Fee',
      text: 'Our clinic desk confirms the doctor’s schedule, available appointment slot, and consultation fee in chat.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Direct UPI Payment',
      text: 'Pay via any UPI app directly to +91 99938 95629 and send the payment screenshot in the chat.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Receive Confirmation & Video Link',
      text: 'Receive your verified consultation confirmation and secure video meeting link.',
    },
  ],
};
---

<Base title={title} metaDescription={metaDescription} schema={schema}>
  <div class="page-container container">
    <Breadcrumbs crumbs={[{ name: "How to Book", url: "/how-to-book/" }]} />

    <header class="page-header">
      <span class="badge">Booking & Payment Policy</span>
      <h1>How to Book Consultations & Digital Programs</h1>
      <p class="lead">
        Transparent, WhatsApp-first scheduling and direct UPI payments for in-clinic visits, online teleconsultations, and student programs.
      </p>
    </header>

    <div class="how-to-grid">
      <div class="main-content">
        <section class="steps-card">
          <h2>The 4-Step Booking Process</h2>
          <div class="step-item">
            <div class="step-number">1</div>
            <div class="step-details">
              <h3>Initiate on WhatsApp</h3>
              <p>
                Click any consultation or program button across our website. This automatically opens WhatsApp with a prefilled message indicating the specific service you need (e.g., <code>[web-consult]</code> or <code>[web-second-opinion]</code>).
              </p>
            </div>
          </div>

          <div class="step-item">
            <div class="step-number">2</div>
            <div class="step-details">
              <h3>Confirm Availability & Fee in Chat</h3>
              <p>
                Dr. Mudita or our clinic coordination desk will review your request, confirm doctor availability, provide available date/time slots, and share the consultation fee.
              </p>
              <div class="notice-box">
                <strong>Important:</strong> We always confirm appointment availability and slot before accepting any payment. Please do not make any payment prior to mutual confirmation in the chat.
              </div>
            </div>
          </div>

          <div class="step-item">
            <div class="step-number">3</div>
            <div class="step-details">
              <h3>Secure UPI Payment</h3>
              <p>
                Once your slot is agreed upon, make a payment via any UPI application (Google Pay, PhonePe, Paytm, BHIM) directly to our official clinic number:
              </p>
              <p class="upi-highlight">
                Official UPI Number: <strong>+91 99938 95629</strong>
              </p>
              <p>
                Take a screenshot of the completed transaction and share it directly in the same WhatsApp chat for instant verification.
              </p>
            </div>
          </div>

          <div class="step-item">
            <div class="step-number">4</div>
            <div class="step-details">
              <h3>Receive Confirmation & Meeting Access</h3>
              <p>
                Upon screenshot verification, you will receive a formal appointment confirmation message along with your Google Meet or WhatsApp video consultation link, intake questionnaire, and instructions for uploading prior medical reports.
              </p>
            </div>
          </div>
        </section>

        <section class="security-card">
          <h2>Anti-Fraud & Security Guarantee</h2>
          <p>
            To protect our patients and students from unauthorized payment solicitations:
          </p>
          <ul>
            <li>We <strong>only</strong> accept payments to <strong>+91 99938 95629</strong>.</li>
            <li>We <strong>never</strong> ask for card numbers, CVVs, passwords, or banking OTPs.</li>
            <li>Our website never collects credit card details or bank account credentials.</li>
            <li>Always verify that you are communicating with our verified WhatsApp number: <strong>+91 99938 95629</strong>.</li>
          </ul>
        </section>

        <section class="reschedule-card">
          <h2>Rescheduling & Cancellation Policy</h2>
          <p>
            We understand that medical and personal schedules change unexpectedly.
          </p>
          <ul>
            <li><strong>Rescheduling:</strong> You can reschedule once at no cost with at least 4 hours' notice by messaging us on WhatsApp.</li>
            <li><strong>If we can't provide the service:</strong> If we are unable to provide your confirmed service, you receive a full refund.</li>
            <li><strong>After delivery:</strong> Fees are not refundable once the consultation, program session or course access has been delivered.</li>
          </ul>
          <p><a href="/booking-policy/">Read the full booking policy</a></p>
        </section>
      </div>

      <aside class="sidebar">
        <div class="sidebar-box">
          <h3>Need Assistance?</h3>
          <p>Have questions about appointment timings or technical setup?</p>
          <div class="sidebar-ctas">
            <WhatsAppCTA title="Chat with Clinic Desk" question="Hello, I have a question regarding booking a consultation." slug="how-to-book-sidebar" />
            <CallCTA />
          </div>
        </div>

        <div class="sidebar-box info-box">
          <h4>Clinic Working Hours</h4>
          <p><strong>Monday – Friday:</strong> 5:00 PM – 8:00 PM</p>
          <p><strong>Saturday & Sunday:</strong> Closed (Emergencies: Visit Local Hospital)</p>
          <p><small>WhatsApp messages can be sent anytime; responses are provided during operational hours.</small></p>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .page-container {
    padding: 30px 20px 60px 20px;
  }
  .page-header {
    margin-bottom: 35px;
  }
  .badge {
    background: #e0f2fe;
    color: #0369a1;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 4px;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 10px;
  }
  .page-header h1 {
    font-size: 32px;
    color: #172b54;
    margin-bottom: 10px;
  }
  .lead {
    font-size: 16px;
    color: #475569;
    max-width: 800px;
  }
  .how-to-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 40px;
  }
  .steps-card, .security-card, .reschedule-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 30px;
    margin-bottom: 30px;
  }
  .steps-card h2, .security-card h2, .reschedule-card h2 {
    color: #172b54;
    font-size: 22px;
    margin-bottom: 25px;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 12px;
  }
  .step-item {
    display: flex;
    gap: 20px;
    margin-bottom: 25px;
  }
  .step-number {
    width: 40px;
    height: 40px;
    background: #172b54;
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .step-details h3 {
    font-size: 18px;
    color: #1e293b;
    margin-bottom: 8px;
  }
  .step-details p {
    font-size: 15px;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 10px;
  }
  .notice-box {
    background: #fffbeb;
    border-left: 4px solid #f59e0b;
    padding: 12px 16px;
    font-size: 14px;
    color: #92400e;
    border-radius: 4px;
    margin-top: 10px;
  }
  .upi-highlight {
    background: #ecfdf5;
    border: 1px dashed #10b981;
    padding: 10px 16px;
    border-radius: 6px;
    color: #065f46;
    font-size: 15px;
    display: inline-block;
  }
  .security-card ul, .reschedule-card ul {
    padding-left: 20px;
    color: #475569;
    font-size: 15px;
    line-height: 1.7;
  }
  .sidebar-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 25px;
  }
  .sidebar-box h3, .sidebar-box h4 {
    color: #172b54;
    margin-bottom: 12px;
  }
  .sidebar-box p {
    font-size: 14px;
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .info-box {
    background: #f8fafc;
  }
  @media (max-width: 900px) {
    .how-to-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

