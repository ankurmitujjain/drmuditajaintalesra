---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const title = "Gynecology & Obstetrics Services in Bhopal | Dr. Mudita Jain";
const metaDescription = "Comprehensive women's healthcare services in Bhopal: laparoscopy, obstetrics, fertility, cosmetic gynecology, MTP, cervical health, and vaginal surgery.";
---

<Base title={title} metaDescription={metaDescription}>
  <div class="page-container container">
    <Breadcrumbs crumbs={[{ name: "Services", url: "/our-services/" }]} />

    <header class="page-header text-center">
      <span class="badge">Clinical Specializations</span>
      <h1>Women's Health & Gynecology Services in Bhopal</h1>
      <p class="lead">
        Evidence-based, confidential healthcare led by <strong>Dr. Mudita Jain Talesra (MS, FMAS, FICOG)</strong> in Gulmohar Colony, Bhopal.
      </p>
    </header>

    <div class="services-list">
      {services.map((service, idx) => (
        <article class={`service-row ${idx % 2 === 1 ? 'reverse' : ''}`}>
          <div class="service-media">
            <img src={service.data.heroImage} alt={service.data.title} width="480" height="300" loading="lazy" class="service-img" />
          </div>
          <div class="service-content">
            <h2><a href={`/${(service.id || service.slug)}/`}>{service.data.title}</a></h2>
            <p class="direct-answer">{service.data.directAnswer}</p>
            <div class="service-actions">
              <a href={`/${(service.id || service.slug)}/`} class="btn-primary">View Treatment Details & FAQs →</a>
              <WhatsAppCTA title={service.data.title} question="I would like to inquire about this service." slug={(service.id || service.slug)} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  .page-container {
    padding: 30px 20px 60px 20px;
  }
  .page-header {
    max-width: 750px;
    margin: 0 auto 50px auto;
  }
  .text-center {
    text-align: center;
  }
  .badge {
    background: #e0f2fe;
    color: #0369a1;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: inline-block;
    margin-bottom: 10px;
  }
  .page-header h1 {
    font-size: 34px;
    color: #172b54;
    margin-bottom: 10px;
  }
  .lead {
    font-size: 16px;
    color: #475569;
  }

  .services-list {
    display: flex;
    flex-direction: column;
    gap: 50px;
  }
  .service-row {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 40px;
    align-items: center;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 24px;
  }
  .service-row.reverse {
    grid-template-columns: 1.2fr 1fr;
  }
  .service-row.reverse .service-media {
    order: 2;
  }
  .service-row.reverse .service-content {
    order: 1;
  }
  .service-img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 8px;
  }
  .service-content h2 {
    font-size: 24px;
    margin-bottom: 12px;
  }
  .service-content h2 a {
    color: #172b54;
  }
  .direct-answer {
    font-size: 15px;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 20px;
  }
  .service-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .btn-primary {
    display: inline-block;
    background: #172b54;
    color: #ffffff !important;
    font-size: 14px;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 6px;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .service-row,
    .service-row.reverse {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .service-row.reverse .service-media,
    .service-row.reverse .service-content {
      order: unset;
    }
    .service-img {
      height: 200px;
    }
  }
</style>
