---
interface Crumb {
  name: string;
  url: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    <li><a href="/">Home</a></li>
    {crumbs.map((crumb, idx) => (
      <li>
        <span class="sep">/</span>
        {idx === crumbs.length - 1 ? (
          <span aria-current="page" class="current">{crumb.name}</span>
        ) : (
          <a href={crumb.url}>{crumb.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    font-size: 13px;
    margin-bottom: 20px;
    color: #64748b;
  }
  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 0;
    margin: 0;
  }
  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .breadcrumbs a {
    color: #172b54;
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .sep {
    color: #94a3b8;
  }
  .current {
    color: #475569;
    font-weight: 500;
  }
</style>
